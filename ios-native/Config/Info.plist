<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CCHSharedKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.cybercabhunter.shared</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cybercabhunter.native.widget-links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cybercabhunter-widget</string>
			</array>
		</dict>
	</array>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Cyber Cab Hunter</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>sigh ber cab hunter</string>
		</dict>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location helps you find nearby Cybercab service zones, sightings, and cameras. Location is optional and is used only when you request it.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>PushEnvironment</key>
	<string>$(PUSH_ENVIRONMENT)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Variable.ttf</string>
		<string>GeistMono-Variable.ttf</string>
	</array>
</dict>
</plist>
