{
	"name": "cybercabhunter",
	"main": "worker/index.js",
	"compatibility_date": "2024-09-23",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		"FRONTEND_URL": "https://cybercabhunter.com/",
		"RECEIPT_DOMAIN": "cybercabhunter.com",
		"TESLA_RIDES_REDIRECT_URI": "https://cybercabhunter.com/api/tesla/rides/callback",
		"TESLA_RIDES_AUDIENCE": "https://fleet-api.prd.na.vn.cloud.tesla.com",
		"TESLA_RIDES_SCOPES": "openid offline_access",
		"GOOGLE_REDIRECT_URI": "https://cybercabhunter.com/oauth/google/callback",
		"GMAIL_REDIRECT_URI": "https://cybercabhunter.com/api/gmail/callback"
	},
	// Polls connected Gmail accounts for new receipts (worker/gmail.js). A
	// no-op until the GMAIL_* secrets are set.
	"triggers": {
		// Every 10 min: Gmail sync + photo expiry. Daily 11:00 UTC: Fleet & Fares
		// recompute (worker/fleet-stats.js FLEET_STATS_CRON — keep the two equal).
		// Daily 11:30 UTC: the TxDMV AV roster snapshot (worker/txdmv.js TXDMV_CRON).
		"crons": ["*/10 * * * *", "0 11 * * *", "30 11 * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "TESLA_SESSIONS",
			"id": "3b4c90b3fd1b40efbc5722fea72d90c0"
		}
	],
	"d1_databases": [
		{
			"binding": "cybercabhunter_db",
			"database_name": "cybercabhunter-db",
			"database_id": "1873d232-f799-4a4c-915a-615df4556841"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVIDENCE_BUCKET",
			"bucket_name": "cybercabhunter-evidence"
		}
	],
	"ratelimits": [
		{
			"name": "MUSE_RIDES_LIMITER",
			"namespace_id": "7301",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			// Account deletion (worker/account.js): a coarse brake per account.
			"name": "ACCOUNT_DELETE_LIMITER",
			"namespace_id": "7302",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			// Community reviews (worker/reviews.js): review, comment and like
			// writes, per rider.
			"name": "REVIEWS_LIMITER",
			"namespace_id": "7303",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			// Rider search on the Community page (worker/community.js), per
			// rider or per IP. Typing with a 250ms debounce stays well under it.
			"name": "SEARCH_LIMITER",
			"namespace_id": "7304",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	}
}