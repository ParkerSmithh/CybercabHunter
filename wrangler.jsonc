{
	"name": "cybercabhunter",
	"main": "worker/index.js",
	"compatibility_date": "2024-09-23",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		"FRONTEND_URL": "https://cybercabhunter.com/",
		"RECEIPT_DOMAIN": "cybercabhunter.com",
		"TESLA_RIDES_REDIRECT_URI": "https://cybercabhunter.com/api/tesla/rides/callback",
		"TESLA_RIDES_AUDIENCE": "https://fleet-api.prd.na.vn.cloud.tesla.com",
		"TESLA_RIDES_SCOPES": "openid offline_access",
		"GOOGLE_REDIRECT_URI": "https://cybercabhunter.com/oauth/google/callback"
	},
	"kv_namespaces": [
		{
			"binding": "TESLA_SESSIONS",
			"id": "3b4c90b3fd1b40efbc5722fea72d90c0"
		}
	],
	"d1_databases": [
		{
			"binding": "cybercabhunter_db",
			"database_name": "cybercabhunter-db",
			"database_id": "1873d232-f799-4a4c-915a-615df4556841"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVIDENCE_BUCKET",
			"bucket_name": "cybercabhunter-evidence"
		}
	],
	"ratelimits": [
		{
			"name": "MUSE_RIDES_LIMITER",
			"namespace_id": "7301",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	}
}